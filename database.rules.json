{
  "rules": {
    ".read": false,
    ".write": false,
    "sessions": {
      "$uid": {
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.child('code').isString() && root.child('users').child(newData.child('code').val()).exists() && (!root.child('users').child(newData.child('code').val()).child('pass').exists() || newData.child('pass').val() === root.child('users').child(newData.child('code').val()).child('pass').val())",
        "code": {
          ".validate": "newData.val().matches(/^[A-Z0-9]{4,20}$/)"
        },
        "pass": {
          ".validate": "newData.isString() && newData.val().length <= 30"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "users": {
      ".read": "auth != null && root.child('users').child(root.child('sessions').child(auth.uid).child('code').val()).exists() && root.child('users').child(root.child('sessions').child(auth.uid).child('code').val()).child('role').val() === 'leader'",
      ".write": "auth != null && root.child('users').child(root.child('sessions').child(auth.uid).child('code').val()).exists() && root.child('users').child(root.child('sessions').child(auth.uid).child('code').val()).child('role').val() === 'leader'",
      "$code": {
        ".read": "auth != null && root.child('users').child(root.child('sessions').child(auth.uid).child('code').val()).exists() && root.child('sessions').child(auth.uid).child('code').val() === $code",
        ".validate": "$code.matches(/^[A-Z0-9]{4,20}$/) && newData.hasChildren(['name','role'])",
        "name": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 24"
        },
        "role": {
          ".validate": "newData.val() === 'leader' || newData.val() === 'member'"
        },
        "slot": {
          ".validate": "newData.isString() && newData.val().matches(/^([0-9]|1[0-9]|2[0-4])$/)"
        },
        "pass": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 30"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "calc": {
      ".read": "auth != null && root.child('users').child(root.child('sessions').child(auth.uid).child('code').val()).exists()",
      ".write": "auth != null && root.child('users').child(root.child('sessions').child(auth.uid).child('code').val()).exists() && root.child('users').child(root.child('sessions').child(auth.uid).child('code').val()).child('role').val() === 'leader'",
      "bp": {
        ".validate": "newData.isNumber() && newData.val() >= 0"
      },
      "bs": {
        ".validate": "newData.isNumber() && newData.val() >= 0"
      },
      "rp": {
        ".validate": "newData.isNumber() && newData.val() >= 0"
      },
      "rs": {
        ".validate": "newData.isNumber() && newData.val() >= 0"
      },
      "tot": {
        ".validate": "newData.isNumber() && newData.val() >= 0"
      },
      "endAt": {
        ".validate": "newData.isNumber()"
      },
      "ts": {
        ".validate": "newData.isNumber()"
      },
      "$other": {
        ".validate": false
      }
    },
    "attacks": {
      ".read": "auth != null && root.child('users').child(root.child('sessions').child(auth.uid).child('code').val()).exists()",
      "$slot": {
        ".write": "auth != null && root.child('users').child(root.child('sessions').child(auth.uid).child('code').val()).exists() && root.child('users').child(root.child('sessions').child(auth.uid).child('code').val()).child('role').val() === 'leader'",
        ".validate": "$slot.matches(/^([0-9]|1[0-9]|2[0-4])$/)",
        "name": {
          ".validate": "newData.isString() && newData.val().length <= 24"
        },
        "cars": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 3"
        },
        "done": {
          ".write": "auth != null && root.child('users').child(root.child('sessions').child(auth.uid).child('code').val()).exists() && root.child('users').child(root.child('sessions').child(auth.uid).child('code').val()).child('slot').val() === $slot",
          ".validate": "newData.isBoolean()"
        },
        "unavail": {
          ".write": "auth != null && root.child('users').child(root.child('sessions').child(auth.uid).child('code').val()).exists() && root.child('users').child(root.child('sessions').child(auth.uid).child('code').val()).child('slot').val() === $slot",
          ".validate": "newData.isBoolean()"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "chat": {
      ".read": "auth != null && root.child('users').child(root.child('sessions').child(auth.uid).child('code').val()).exists()",
      "$id": {
        ".write": "auth != null && root.child('users').child(root.child('sessions').child(auth.uid).child('code').val()).exists() && !data.exists() && newData.exists()",
        ".validate": "newData.hasChildren(['user','text','ts','uid'])",
        "user": {
          ".validate": "newData.isString() && newData.val() === root.child('users').child(root.child('sessions').child(auth.uid).child('code').val()).child('name').val()"
        },
        "text": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 500"
        },
        "ts": {
          ".validate": "newData.val() === now"
        },
        "uid": {
          ".validate": "newData.val() === auth.uid"
        },
        "$other": {
          ".validate": false
        }
      }
    }
  }
}